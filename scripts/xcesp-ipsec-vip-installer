#!/bin/sh
# xcesp-ipsec-vip-installer — per-connection IPsec virtual-IP installer
#
# Called by strongSwan's `updown` hook when a CHILD_SA is installed or
# removed for a connection that has `install-vip-on <ifname>` set in
# its XCESP config.  Adds the assigned virtual IP (PLUTO_MY_SOURCEIP)
# to <ifname> on `up-*` and removes it on `down-*`.
#
# Usage (invoked by charon, not directly):
#     xcesp-ipsec-vip-installer <target-ifname>
#
# Environment variables set by strongSwan:
#     PLUTO_VERB            up-client | up-host | down-client | down-host | ...
#     PLUTO_MY_SOURCEIP     the IKEv2-assigned virtual IP (empty if none)
#     PLUTO_CONNECTION      connection name (for logging only)
#     PLUTO_UNIQUEID        SA unique id (for logging only)
#
# Bypasses strongSwan's global `charon.install_virtual_ip_on` (which
# accepts only ONE interface per charon instance and therefore can't
# support multi-hub topologies where each hub assigns a distinct VIP).
# Paired with `charon.install_virtual_ip = no` in strongswan.conf so
# charon does NOT also install the VIP on `lo` (avoiding double-install
# / duplicate route conflicts).
#
# Capability handling (0.4.12+):
# `ip addr add/del` requires CAP_NET_ADMIN.  charon does NOT reliably
# pass its own caps to forked child processes (xcesptest observed
# CapPrm=0 on the running charon despite the binary having file caps,
# because `ip netns exec` in the launch chain sets `no_new_privs`
# which suppresses subsequent file-cap application).  Instead we
# exec through `/usr/lib/xcesp/xcesp-ip` — a tiny C wrapper shipped
# by xcesppkg install.sh with file caps `cap_net_admin,cap_net_raw=ep`
# that raises them ambient before exec'ing the real `ip`.  Its own
# file caps apply regardless of what the forking parent has.
#
# Fallback to plain `ip` when the wrapper isn't installed — useful for
# standalone strongSwan setups outside XCESP where charon typically
# runs as root and the caps issue doesn't arise.

IFACE="${1:?target interface name required as argv[1]}"
VERB="${PLUTO_VERB:-}"
VIP="${PLUTO_MY_SOURCEIP:-}"
CONN="${PLUTO_CONNECTION:-<no-conn>}"

# No VIP assigned for this SA — nothing to install.
[ -n "$VIP" ] || exit 0

# Pick the ip binary — prefer the caps-raising wrapper.
if [ -x /usr/lib/xcesp/xcesp-ip ]; then
    IP=/usr/lib/xcesp/xcesp-ip
else
    IP=ip
fi

case "$VERB" in
    up-client|up-host)
        OUT=$("$IP" addr add "$VIP/32" dev "$IFACE" 2>&1)
        RC=$?
        # RC=2 with 'File exists' → already installed (idempotent, benign).
        # Any other non-zero → log the actual error so operators can debug.
        if [ $RC -ne 0 ] && ! printf '%s' "$OUT" | grep -q "File exists"; then
            logger -t xcesp-vip \
                "FAILED add $VIP on $IFACE (conn=$CONN rc=$RC): $OUT"
        else
            logger -t xcesp-vip \
                "installed $VIP on $IFACE (conn=$CONN verb=$VERB)"
        fi
        ;;
    down-client|down-host)
        OUT=$("$IP" addr del "$VIP/32" dev "$IFACE" 2>&1)
        RC=$?
        if [ $RC -ne 0 ] && ! printf '%s' "$OUT" | grep -q "Cannot assign"; then
            logger -t xcesp-vip \
                "FAILED del $VIP from $IFACE (conn=$CONN rc=$RC): $OUT"
        else
            logger -t xcesp-vip \
                "removed $VIP from $IFACE (conn=$CONN verb=$VERB)"
        fi
        ;;
esac

exit 0
